# Copy this file to .env if you want to override defaults. Never commit
# .env or upload it in a submission ZIP -- the platform injects OPENAI_BASE_URL /
# OPENAI_API_KEY itself at run time, using its own model proxy and a temporary
# credential.
#
# Defaults to the Kimi Coding Plan (https://www.kimi.com/code/docs/en/):
#   OPENAI_BASE_URL  https://api.kimi.com/coding/v1 (mainland China) -- accounts outside
#                    mainland China should use https://api.kimi.ai/coding/v1 instead
#   OPENAI_MODEL     k3
# Any other OpenAI-compatible /chat/completions endpoint works too: just set
# OPENAI_BASE_URL / OPENAI_MODEL to override the defaults above.

OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional: deterministic scheduling is the default. Set to 1 to enable LLM advice.
AGENT_USE_LLM=0
# Required only when AGENT_USE_LLM=1. KIMI_API_KEY is also accepted.
OPENAI_API_KEY=

# Optional: path to a JSONL file the agent appends a decision trace to (night advice,
# the finish summary). Leave unset to disable; the write is best-effort and never
# crashes the agent if the path is not writable.
AGENT_TRACE_PATH=
